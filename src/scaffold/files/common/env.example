# Copy this file to .env.local and fill in what you have. Every line is optional for local runs.

# The site's own address, used in email links.
SITE_URL=http://localhost:3000

# The model. Gemini Flash is the default.
GEMINI_API_KEY=
# Or any OpenAI-compatible server, a local one included:
# COMPLYRAIL_MODEL_BASE_URL=http://localhost:11434/v1
# COMPLYRAIL_MODEL=llama3.1
# COMPLYRAIL_MODEL_API_KEY=
# Minimum milliseconds between model calls. A free tier may need about 13000.
COMPLYRAIL_MODEL_INTERVAL_MS=0

# Payments. Without a key, development mode takes no payment.
STRIPE_SECRET_KEY=

# Orders and files. Without these, they are kept in .complyrail/ on this machine.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
COMPLYRAIL_BUCKET=

# Mail. Without a host, messages are written to .complyrail/outbox/.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Chrome or Chromium prints the PDFs. Set this when the browser is not on the PATH.
CHROME_PATH=
